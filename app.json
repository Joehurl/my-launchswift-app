{
  "expo": {
    "name": "LaunchSwift",
    "slug": "launchswift",
    "version": "1.0.0",
    "description": "LaunchSwift \u2014 The ultimate App Store submission assistant. AI-powered guidance for every step of getting your app approved.",
    "orientation": "portrait",
    "icon": "./assets/images/84c8bbe6-9684-499d-a21b-af66c880f25e.jpeg",
    "userInterfaceStyle": "automatic",
    "jsEngine": "hermes",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/84c8bbe6-9684-499d-a21b-af66c880f25e.jpeg",
      "resizeMode": "contain",
      "backgroundColor": "#1A56DB"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.josephhurley.launchswift.app",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/84c8bbe6-9684-499d-a21b-af66c880f25e.jpeg",
        "backgroundColor": "#1A56DB"
      },
      "package": "com.josephhurley.launchswift",
      "versionCode": 1
    },
    "web": {
      "favicon": "./assets/images/84c8bbe6-9684-499d-a21b-af66c880f25e.jpeg",
      "bundler": "metro"
    },
    "plugins": [
      "expo-font",
      "expo-router",
      "expo-web-browser",
      "expo-secure-store"
    ],
    "scheme": "launchswift",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {}
    }
  }
}